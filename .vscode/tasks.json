{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build OpenKey (Release x64)",
            "type": "shell",
            "command": "msbuild",
            "args": [
                "Sources/OpenKey/win32/OpenKey/OpenKey.sln",
                "/p:Configuration=Release",
                "/p:Platform=x64",
                "/m"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build OpenKey (Debug x64)",
            "type": "shell",
            "command": "msbuild",
            "args": [
                "Sources/OpenKey/win32/OpenKey/OpenKey.sln",
                "/p:Configuration=Debug",
                "/p:Platform=x64",
                "/m"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build OpenKey (Release x86)",
            "type": "shell",
            "command": "msbuild",
            "args": [
                "Sources/OpenKey/win32/OpenKey/OpenKey.sln",
                "/p:Configuration=Release",
                "/p:Platform=Win32",
                "/m"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Clean OpenKey",
            "type": "shell",
            "command": "msbuild",
            "args": [
                "Sources/OpenKey/win32/OpenKey/OpenKey.sln",
                "/t:Clean",
                "/p:Configuration=Release",
                "/p:Platform=x64"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": "$msCompile"
        }
    ]
}
