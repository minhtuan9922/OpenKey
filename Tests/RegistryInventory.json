        },
        {
          "scope": "fluent-only",
          "type": "REG_BINARY",
          "names": ["uiWindowSize", "uiWindowPosition"]
        }
      ]
    },
    {
      "hive": "HKEY_CURRENT_USER",
      "path": "Software\\Microsoft\\Windows\\CurrentVersion\\Run",
      "groups": [{"scope": "startup", "type": "REG_SZ", "names": ["OpenKey"]}]
    }
  ]
}
