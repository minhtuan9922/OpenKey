          "names": [
            "vLanguage", "vInputType", "vCodeTable", "vCheckSpelling",
            "vRestoreIfWrongSpelling", "vRememberCode", "vUseModernOrthography",
            "vQuickTelex", "vQuickStartConsonant", "vQuickEndConsonant", "vAutoCapsMacro",
            "vUseMacro", "vUseMacroInEnglishMode",
            "vSwitchKeyStatus", "vFixRecommendBrowser", "vSendKeyStepByStep",
            "vUseSmartSwitchKey", "vSupportMetroApp", "vOtherLanguage", "vTempOffOpenKey",
            "vFixChromiumBrowser", "vUpperCaseFirstChar", "vAllowConsonantZFWJ",
            "vTempOffSpelling", "vUseGrayIcon", "vRunWithWindows", "vShowOnStartUp",
            "vCheckNewVersion", "convertToolDontAlertWhenCompleted", "convertToolToAllCaps",
            "convertToolToAllNonCaps", "convertToolToCapsFirstLetter", "convertToolToCapsEachWord",
            "convertToolRemoveMark", "convertToolFromCode", "convertToolToCode", "convertToolHotKey"
