if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" OR NOT OPENKEY_BUILD_FCITX5 OR NOT OPENKEY_BUILD_UI OR NOT OPENKEY_BUILD_SERVICE)
    message(FATAL_ERROR "Beta DEB requires Linux, FCITX5, UI and SERVICE")
endif()
if(OPENKEY_BUILD_DEB OR OPENKEY_BUILD_UI_DEB OR CMAKE_CROSSCOMPILING OR NOT CMAKE_INSTALL_PREFIX STREQUAL "/usr")
    message(FATAL_ERROR "Beta DEB needs a native /usr build with other DEB modes OFF")
endif()
if(IS_ABSOLUTE "${CMAKE_INSTALL_LIBDIR}" OR IS_ABSOLUTE "${CMAKE_INSTALL_DATADIR}")
    message(FATAL_ERROR "Beta DEB requires relative install directories")
endif()
find_program(OPENKEY_BETA_DPKG dpkg REQUIRED)
find_program(OPENKEY_BETA_SHLIBDEPS dpkg-shlibdeps REQUIRED)
execute_process(COMMAND "${OPENKEY_BETA_DPKG}" --print-architecture OUTPUT_VARIABLE beta_arch
    OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
install(FILES "${PROJECT_SOURCE_DIR}/packaging/linux/openkey-tray.desktop" DESTINATION /etc/xdg/autostart)
install(FILES "${PROJECT_SOURCE_DIR}/LICENSE" DESTINATION share/doc/openkey RENAME copyright)
install(FILES "${PROJECT_SOURCE_DIR}/docs/UBUNTU_BETA.md" DESTINATION share/doc/openkey RENAME README.md)
install(FILES "${PROJECT_SOURCE_DIR}/docs/UBUNTU_APP_MEMORY.md" "${PROJECT_SOURCE_DIR}/docs/UBUNTU_GNOME_IDENTITY.md"
    "${PROJECT_SOURCE_DIR}/docs/UBUNTU_NATIVE_DIRECT.md" DESTINATION share/doc/openkey)
install(PROGRAMS "${PROJECT_SOURCE_DIR}/scripts/linux-compat-report.py" DESTINATION bin RENAME openkey-compat-report)
set(beta_extension_dir "share/gnome-shell/extensions/openkey-app-identity@openkey.local")
install(FILES "${PROJECT_SOURCE_DIR}/tools/gnome-app-identity/metadata.json"
    "${PROJECT_SOURCE_DIR}/tools/gnome-app-identity/extension.js"
    "${PROJECT_SOURCE_DIR}/tools/gnome-app-identity/focusState.js"
    "${PROJECT_SOURCE_DIR}/tools/gnome-app-identity/protocol.js"
    "${PROJECT_SOURCE_DIR}/LICENSE" DESTINATION "${beta_extension_dir}")
set(CPACK_GENERATOR DEB)
set(CPACK_PACKAGE_NAME openkey)
set(CPACK_PACKAGE_VENDOR "OpenKey contributors")
set(CPACK_PACKAGE_CONTACT "TuanPham <minhtuan9922@gmail.com>")
set(CPACK_PACKAGE_VERSION "3.1.0~beta.2~alpha.7")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "OpenKey Vietnamese input method, settings and tray for Ubuntu")
set(CPACK_PACKAGE_DESCRIPTION "Beta Vietnamese input method for Ubuntu 26.04.\n Includes the Fcitx5 addon, Qt Quick settings, session tray, diagnostics\n and optional GNOME Shell 50 application identity extension.\n Install with apt to resolve runtime dependencies. Session input-method\n selection and enabling the GNOME extension are per-user setup steps.")
set(CPACK_DEBIAN_PACKAGE_RELEASE 1)
set(CPACK_DEBIAN_PACKAGE_ARCHITECTURE "${beta_arch}")
set(CPACK_DEBIAN_FILE_NAME DEB-DEFAULT)
set(CPACK_DEBIAN_PACKAGE_SECTION utils)
set(CPACK_DEBIAN_PACKAGE_PRIORITY optional)
set(CPACK_DEBIAN_PACKAGE_HOMEPAGE "https://github.com/minhtuan9922/OpenKey")
set(CPACK_DEBIAN_PACKAGE_CONFLICTS "fcitx5-openkey, openkey-settings")
set(CPACK_DEBIAN_PACKAGE_REPLACES "fcitx5-openkey, openkey-settings")
set(CPACK_DEBIAN_PACKAGE_PROVIDES "fcitx5-openkey, openkey-settings")
set(CPACK_DEBIAN_PACKAGE_DEPENDS "fcitx5 (>= 5.1.19), fcitx5-module-dbus, fcitx5-module-ibus, fcitx5-module-wayland, fcitx5-config-qt, fcitx5-frontend-gtk3, fcitx5-frontend-gtk4, fcitx5-frontend-qt5, fcitx5-frontend-qt6, im-config, dbus-user-session, python3, qml6-module-qtquick, qml6-module-qtquick-controls, qml6-module-qtquick-layouts, qml6-module-qtquick-window, qml6-module-qtquick-templates, qml6-module-qtqml-workerscript, qml6-module-qtquick-dialogs")
set(CPACK_DEBIAN_PACKAGE_RECOMMENDS "gnome-shell-extension-appindicator")
set(CPACK_DEBIAN_PACKAGE_CONTROL_EXTRA "${PROJECT_SOURCE_DIR}/packaging/linux/conffiles")
set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
set(CPACK_DEBIAN_COMPRESSION_TYPE xz)
set(CPACK_SET_DESTDIR ON)
set(CPACK_PACKAGING_INSTALL_PREFIX /usr)
set(CPACK_PACKAGE_DIRECTORY "${PROJECT_SOURCE_DIR}/dist/linux")
set(CPACK_PACKAGE_CHECKSUM SHA256)
set(CPACK_STRIP_FILES ON)
set(CPACK_INSTALL_CMAKE_PROJECTS "${PROJECT_BINARY_DIR};${PROJECT_NAME};ALL;/")
set(CPACK_INSTALL_DEFAULT_DIRECTORY_PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
include(CPack)
