# Synthetic, unprivileged dpkg payload lifecycle. Run explicitly with:
# cmake -DDEB_PATH=/absolute/package.deb -DSANDBOX_PARENT=/absolute/sandbox -P this-file
# Retain every run, including failed runs, for inspection. Never configure.
cmake_minimum_required(VERSION 3.16)

foreach(required DEB_PATH SANDBOX_PARENT)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${required}")
    endif()
    # These values become CMake command argument lists and retained log records.
    if("${${required}}" MATCHES "[;\r\n]")
        message(FATAL_ERROR "${required} contains an unsupported argument separator")
    endif()
endforeach()
if(NOT IS_ABSOLUTE "${SANDBOX_PARENT}")
    message(FATAL_ERROR "SANDBOX_PARENT must be absolute")
endif()
get_filename_component(lifecycle_parent "${SANDBOX_PARENT}" REALPATH)
if(lifecycle_parent STREQUAL "/")
    message(FATAL_ERROR "SANDBOX_PARENT must not resolve to /")
endif()
get_filename_component(DEB_PATH "${DEB_PATH}" ABSOLUTE)
if(NOT EXISTS "${DEB_PATH}" OR IS_DIRECTORY "${DEB_PATH}")
    message(FATAL_ERROR "DEB_PATH must name an existing package")
endif()
find_program(LIFECYCLE_ID id REQUIRED)
find_program(LIFECYCLE_TEST test REQUIRED)
find_program(LIFECYCLE_DPKG dpkg REQUIRED)
find_program(LIFECYCLE_QUERY dpkg-query REQUIRED)
find_program(LIFECYCLE_DEB dpkg-deb REQUIRED)
execute_process(COMMAND "${LIFECYCLE_ID}" -u RESULT_VARIABLE uid_result
    OUTPUT_VARIABLE lifecycle_uid OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_VARIABLE uid_error TIMEOUT 30)
if(NOT "${uid_result}" STREQUAL "0" OR NOT lifecycle_uid MATCHES "^[0-9]+$"
        OR lifecycle_uid MATCHES "^0+$")
    message(FATAL_ERROR "This lifecycle requires a nonzero UID; privileged execution is refused")
endif()

# dpkg reads host configuration even with a private root. Fail closed before
# invoking dpkg (including the verifier's architecture query). Do not echo lines:
# hook commands and option values can contain private information.
if(NOT DEFINED ENV{HOME} OR "$ENV{HOME}" STREQUAL "")
    message(FATAL_ERROR "HOME must be nonempty and absolute to inspect dpkg configuration safely")
endif()
if(NOT IS_ABSOLUTE "$ENV{HOME}")
    message(FATAL_ERROR "HOME must be nonempty and absolute to inspect dpkg configuration safely")
endif()
set(lifecycle_configs /etc/dpkg/dpkg.cfg)
file(GLOB lifecycle_config_fragments "/etc/dpkg/dpkg.cfg.d/*")
list(APPEND lifecycle_configs ${lifecycle_config_fragments})
list(APPEND lifecycle_configs "$ENV{HOME}/.dpkg.cfg")
foreach(config IN LISTS lifecycle_configs)
    if(NOT EXISTS "${config}" AND NOT IS_SYMLINK "${config}")
        continue()
    endif()
    execute_process(COMMAND "${LIFECYCLE_TEST}" -f "${config}"
        RESULT_VARIABLE regular_result TIMEOUT 30)
    if(NOT "${regular_result}" STREQUAL "0")
        if(IS_DIRECTORY "${config}")
            continue()
        endif()
        message(FATAL_ERROR "Cannot safely inspect a dpkg configuration file")
    endif()
    file(STRINGS "${config}" config_lines ENCODING UTF-8)
    foreach(line IN LISTS config_lines)
        string(STRIP "${line}" line)
        if(line STREQUAL "" OR line MATCHES "^#")
            continue()
        endif()
        if(line STREQUAL "no-debsig" OR line MATCHES "^log([ \t]+|[ \t]*=[ \t]*)[^ \t=].*$")
            continue()
        endif()
        message(FATAL_ERROR "Unsafe or unknown active dpkg configuration directive; contents withheld")
    endforeach()
endforeach()

file(MAKE_DIRECTORY "${lifecycle_parent}")
get_filename_component(lifecycle_parent "${lifecycle_parent}" REALPATH)
if(lifecycle_parent STREQUAL "/")
    message(FATAL_ERROR "SANDBOX_PARENT must not resolve to /")
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef lifecycle_id)
set(lifecycle_run "${lifecycle_parent}/run-${lifecycle_id}")
if(EXISTS "${lifecycle_run}" OR IS_SYMLINK "${lifecycle_run}")
    message(FATAL_ERROR "Refusing an existing run directory")
endif()
set(lifecycle_root "${lifecycle_run}/root")
set(lifecycle_admin "${lifecycle_root}/var/lib/dpkg")
set(lifecycle_log "${lifecycle_run}/dpkg.log")
file(MAKE_DIRECTORY "${lifecycle_admin}/updates" "${lifecycle_admin}/info"
    "${lifecycle_admin}/triggers")
file(WRITE "${lifecycle_admin}/status" "")
# Keep HOME intact, but replace all inherited force options and root settings.
set(ENV{DPKG_FORCE} "not-root")
set(ENV{DPKG_ROOT} "${lifecycle_root}")
set(ENV{DPKG_ADMINDIR} "${lifecycle_admin}")
set(lifecycle_options "--root=${lifecycle_root}" "--admindir=${lifecycle_admin}"
    "--log=${lifecycle_log}" --no-triggers --force-not-root)
message(STATUS "Retained lifecycle run: ${lifecycle_run}")

function(lifecycle_command)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result
        OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
    file(APPEND "${lifecycle_run}/commands.log" "${ARGN}\nresult: ${result}\n${output}${error}\n")
    if(DEFINED lifecycle_fixtures)
        lifecycle_check_fixtures()
    endif()
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "Private lifecycle command failed; inspect retained commands.log")
    endif()
    set(lifecycle_output "${output}" PARENT_SCOPE)
endfunction()

set(EXTRACT_DIR "${lifecycle_run}/preflight")
include("${CMAKE_CURRENT_LIST_DIR}/VerifyLinuxUiDeb.cmake")
set(lifecycle_base_version "${package_version}")

function(lifecycle_check_control directory)
    file(GLOB entries RELATIVE "${directory}" "${directory}/*" "${directory}/.*")
    list(SORT entries)
    if(NOT "${entries}" STREQUAL "control;md5sums")
        message(FATAL_ERROR "Control archive must contain only control and md5sums (no triggers/conffiles/scripts)")
    endif()
    foreach(entry IN LISTS entries)
        if(IS_SYMLINK "${directory}/${entry}" OR IS_DIRECTORY "${directory}/${entry}")
            message(FATAL_ERROR "Control members must be regular files")
        endif()
        execute_process(COMMAND "${LIFECYCLE_TEST}" -f "${directory}/${entry}"
            RESULT_VARIABLE regular_result TIMEOUT 30)
        if(NOT "${regular_result}" STREQUAL "0")
            message(FATAL_ERROR "Control members must be regular files")
        endif()
    endforeach()
endfunction()

lifecycle_check_control("${extraction}/control")
lifecycle_command("${LIFECYCLE_DEB}" --raw-extract "${DEB_PATH}" "${lifecycle_run}/upgrade-source")
set(lifecycle_control "${lifecycle_run}/upgrade-source/DEBIAN")
lifecycle_check_control("${lifecycle_control}")
file(READ "${lifecycle_control}/control" lifecycle_control_before)
string(REGEX MATCHALL "(^|\n)Version:[^\n]*" lifecycle_version_lines "${lifecycle_control_before}")
list(LENGTH lifecycle_version_lines lifecycle_version_count)
if(NOT lifecycle_version_count EQUAL 1)
    message(FATAL_ERROR "Expected exactly one Version control line")
endif()
set(lifecycle_upgrade_version "${lifecycle_base_version}+qa1")
string(REGEX REPLACE "(^|\n)Version:[^\n]*" "\\1Version: ${lifecycle_upgrade_version}"
    lifecycle_control_after "${lifecycle_control_before}")
file(WRITE "${lifecycle_control}/control" "${lifecycle_control_after}")
lifecycle_command("${LIFECYCLE_DPKG}" ${lifecycle_options} --compare-versions
    "${lifecycle_upgrade_version}" gt "${lifecycle_base_version}")
lifecycle_check_control("${lifecycle_control}")
set(lifecycle_upgrade "${lifecycle_run}/upgrade.deb")
lifecycle_command("${LIFECYCLE_DEB}" --build --root-owner-group
    "${lifecycle_run}/upgrade-source" "${lifecycle_upgrade}")

set(lifecycle_fixtures
    home/qa/.config/openkey/ui.ini
    home/qa/.config/fcitx5/conf/openkey.conf
    home/qa/.local/bin/openkey-settings
    home/qa/.local/share/dbus-1/services/org.openkey.Settings.service
    usr/local/bin/sentinel)
foreach(path IN LISTS lifecycle_fixtures)
    get_filename_component(parent "${lifecycle_root}/${path}" DIRECTORY)
    file(MAKE_DIRECTORY "${parent}")
    file(WRITE "${lifecycle_root}/${path}" "OpenKey lifecycle sentinel ${lifecycle_id}: ${path}\n")
    file(SHA256 "${lifecycle_root}/${path}" hash)
    set("lifecycle_fixture_hash_${path}" "${hash}")
endforeach()

function(lifecycle_check_fixtures)
    foreach(path IN LISTS lifecycle_fixtures)
        if(NOT EXISTS "${lifecycle_root}/${path}" OR IS_SYMLINK "${lifecycle_root}/${path}"
                OR IS_DIRECTORY "${lifecycle_root}/${path}")
            message(FATAL_ERROR "Private fixture disappeared or changed type")
        endif()
        file(SHA256 "${lifecycle_root}/${path}" hash)
        if(NOT hash STREQUAL "${lifecycle_fixture_hash_${path}}")
            message(FATAL_ERROR "Private fixture content changed")
        endif()
    endforeach()
endfunction()

function(lifecycle_assert_state present version)
    lifecycle_check_fixtures()
    set(count 0)
    foreach(path IN LISTS expected_files)
        if(present)
            if(NOT EXISTS "${lifecycle_root}/${path}" OR IS_DIRECTORY "${lifecycle_root}/${path}"
                    OR IS_SYMLINK "${lifecycle_root}/${path}")
                message(FATAL_ERROR "Expected regular private payload file: ${path}")
            endif()
            file(SHA256 "${lifecycle_root}/${path}" actual)
            file(SHA256 "${extraction}/root/${path}" expected)
            if(NOT actual STREQUAL expected)
                message(FATAL_ERROR "Private payload checksum changed: ${path}")
            endif()
            math(EXPR count "${count} + 1")
        elseif(EXISTS "${lifecycle_root}/${path}" OR IS_SYMLINK "${lifecycle_root}/${path}")
            message(FATAL_ERROR "Private payload remains after removal: ${path}")
        endif()
    endforeach()
    execute_process(COMMAND "${LIFECYCLE_QUERY}" "--admindir=${lifecycle_admin}"
        --show "--showformat=\${Status}\t\${Version}\n" openkey-settings
        RESULT_VARIABLE result OUTPUT_VARIABLE query ERROR_VARIABLE error TIMEOUT 30)
    file(APPEND "${lifecycle_run}/commands.log"
        "dpkg-query --admindir=${lifecycle_admin} --show openkey-settings\nresult: ${result}\n${query}${error}\n")
    string(STRIP "${query}" query)
    if(present)
        if(NOT "${result}" STREQUAL "0" OR NOT query STREQUAL "install ok unpacked\t${version}")
            message(FATAL_ERROR "Private package must have the expected version and unpacked status")
        endif()
    elseif("${result}" STREQUAL "0")
        if(NOT query MATCHES "^[^ \t]+ ok not-installed(\t|$)")
            message(FATAL_ERROR "Private package is still registered as installed")
        endif()
    elseif(NOT "${result}" STREQUAL "1" OR NOT query STREQUAL "")
        message(FATAL_ERROR "Unexpected private package query failure")
    endif()
    message(STATUS "Private state: payload files=${count}/6; fixture hashes=5/5; query=${result} ${query}")
endfunction()

message(STATUS "Preflight ready; starting synthetic private-root payload cycle")
foreach(stage base reinstall upgrade remove restore purge)
    if(stage STREQUAL "remove" OR stage STREQUAL "purge")
        lifecycle_command("${LIFECYCLE_DPKG}" ${lifecycle_options} "--${stage}" openkey-settings)
        lifecycle_assert_state(FALSE "")
    elseif(stage STREQUAL "upgrade")
        lifecycle_command("${LIFECYCLE_DPKG}" ${lifecycle_options} --unpack "${lifecycle_upgrade}")
        lifecycle_assert_state(TRUE "${lifecycle_upgrade_version}")
    else()
        lifecycle_command("${LIFECYCLE_DPKG}" ${lifecycle_options} --unpack "${DEB_PATH}")
        lifecycle_assert_state(TRUE "${lifecycle_base_version}")
    endif()
    message(STATUS "Private lifecycle stage complete: ${stage}")
endforeach()
lifecycle_assert_state(FALSE "")
message(STATUS "Private payload lifecycle passed; payload-only; no configure/APT/desktop acceptance")
message(STATUS "Retained fixtures, command records and private dpkg log: ${lifecycle_run}")
