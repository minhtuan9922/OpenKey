# Inspect/extract the package and run only its offline resource smoke test.
# Never install the package, run maintainer scripts, or start a session service.
cmake_minimum_required(VERSION 3.16)

foreach(required DEB_PATH EXTRACT_DIR)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
find_program(DPKG_DEB dpkg-deb REQUIRED)
find_program(DPKG dpkg REQUIRED)
find_program(CMAKE_EXECUTABLE cmake REQUIRED)
find_program(DESKTOP_FILE_VALIDATE desktop-file-validate REQUIRED)

function(check_command)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result
        OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "Validation command failed: ${ARGN}\n${output}\n${error}")
    endif()
    set(command_output "${output}" PARENT_SCOPE)
endfunction()

check_command("${DPKG_DEB}" --field "${DEB_PATH}" Package)
string(STRIP "${command_output}" package_name)
if(NOT package_name STREQUAL "openkey-settings")
    message(FATAL_ERROR "Unexpected package: ${package_name}")
endif()
check_command("${DPKG_DEB}" --field "${DEB_PATH}" Version)
string(STRIP "${command_output}" package_version)
if(NOT package_version STREQUAL "3.1.0~preview.13-1")
    message(FATAL_ERROR "Unexpected package version: ${package_version}")
endif()
check_command("${DPKG}" --print-architecture)
string(STRIP "${command_output}" host_arch)
check_command("${DPKG_DEB}" --field "${DEB_PATH}" Architecture)
string(STRIP "${command_output}" package_arch)
if(NOT package_arch STREQUAL host_arch)
    message(FATAL_ERROR "Package architecture ${package_arch} differs from ${host_arch}")
endif()

check_command("${DPKG_DEB}" --field "${DEB_PATH}" Depends)
message(STATUS "Package dependencies: ${command_output}")
string(REPLACE "," ";" dependency_entries "${command_output}")
set(dependency_names)
foreach(entry IN LISTS dependency_entries)
    string(STRIP "${entry}" entry)
    # Match a complete comma-delimited dependency, with optional architecture
    # and version qualifiers. Alternatives do not guarantee the named runtime.
    if(entry MATCHES "^([a-z0-9][a-z0-9+.-]*)(:[a-z0-9-]+)?[ \t]*(\\([^()]*\\))?$")
        list(APPEND dependency_names "${CMAKE_MATCH_1}")
    endif()
endforeach()
# QtConcurrent::run may be header-only for these tasks: its runtime symbols
# are in QtCore, so --as-needed can legitimately omit libQt6Concurrent.
# Let dpkg-shlibdeps derive ELF dependencies instead of inventing that one.
foreach(fragment core gui network dbus quick)
    set(found FALSE)
    foreach(name IN LISTS dependency_names)
        if(name MATCHES "^libqt6${fragment}[0-9][a-z0-9-]*$")
            set(found TRUE)
        endif()
    endforeach()
    if(NOT found)
        message(FATAL_ERROR "Missing Qt runtime dependency: libqt6${fragment}")
    endif()
endforeach()
set(found FALSE)
foreach(name IN LISTS dependency_names)
    if(name MATCHES "^libqt6quickcontrols2-[0-9][a-z0-9-]*$")
        set(found TRUE)
    endif()
endforeach()
if(NOT found)
    message(FATAL_ERROR "Missing Qt Quick Controls runtime dependency")
endif()
foreach(name qml6-module-qtquick qml6-module-qtquick-controls
        qml6-module-qtquick-layouts qml6-module-qtquick-window
        qml6-module-qtquick-templates qml6-module-qtqml-workerscript qml6-module-qtquick-dialogs)
    if(NOT name IN_LIST dependency_names)
        message(FATAL_ERROR "Missing explicit QML runtime dependency: ${name}")
    endif()
endforeach()

if(NOT EXISTS "${DEB_PATH}.sha256")
    message(FATAL_ERROR "Missing SHA-256 sidecar: ${DEB_PATH}.sha256")
endif()
file(SHA256 "${DEB_PATH}" actual_hash)
file(READ "${DEB_PATH}.sha256" checksum)
string(REGEX MATCH "^[0-9a-fA-F]+" expected_hash "${checksum}")
string(TOLOWER "${expected_hash}" expected_hash)
if(NOT actual_hash STREQUAL expected_hash)
    message(FATAL_ERROR "Package SHA-256 does not match its sidecar")
endif()

# Never reuse a previous extraction or remove caller-owned files.
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef validation_id)
set(extraction "${EXTRACT_DIR}/run-${validation_id}")
if(EXISTS "${extraction}")
    message(FATAL_ERROR "Extraction directory already exists: ${extraction}")
endif()
file(MAKE_DIRECTORY "${extraction}")
check_command("${DPKG_DEB}" --extract "${DEB_PATH}" "${extraction}/root")
check_command("${DPKG_DEB}" --control "${DEB_PATH}" "${extraction}/control")
foreach(script preinst postinst prerm postrm)
    if(EXISTS "${extraction}/control/${script}" OR IS_SYMLINK "${extraction}/control/${script}")
        message(FATAL_ERROR "Unexpected maintainer script: ${script}")
    endif()
endforeach()
set(expected_files
    usr/bin/openkey-settings
    usr/share/dbus-1/services/org.openkey.Settings.service
    usr/share/applications/org.openkey.Settings.desktop
    usr/share/doc/openkey-settings/copyright
    usr/share/doc/openkey-settings/README.md
    usr/share/doc/openkey-settings/UI.md)
file(GLOB_RECURSE packaged_files LIST_DIRECTORIES false
    RELATIVE "${extraction}/root" "${extraction}/root/*")
list(SORT expected_files)
list(SORT packaged_files)
if(NOT "${packaged_files}" STREQUAL "${expected_files}")
    message(FATAL_ERROR "Unexpected package payload: ${packaged_files}\nExpected: ${expected_files}")
endif()
foreach(path IN LISTS expected_files)
    if(IS_SYMLINK "${extraction}/root/${path}" OR IS_DIRECTORY "${extraction}/root/${path}")
        message(FATAL_ERROR "Expected a regular file: ${path}")
    endif()
endforeach()
set(prefix "${extraction}/root/usr")
set(desktop "${prefix}/share/applications/org.openkey.Settings.desktop")
check_command("${DESKTOP_FILE_VALIDATE}" "${desktop}")
file(READ "${desktop}" desktop_content)
file(READ "${prefix}/share/dbus-1/services/org.openkey.Settings.service" service_content)
foreach(kind desktop service)
    if(NOT "${${kind}_content}" MATCHES "(^|\n)Exec=(\"/usr/bin/openkey-settings\"|/usr/bin/openkey-settings)[ \t]*(\r?\n|$)")
        message(FATAL_ERROR "${kind} Exec must point to /usr/bin/openkey-settings")
    endif()
endforeach()
if(desktop_content MATCHES "(^|\n)[ \t]*DBusActivatable[ \t]*=")
    message(FATAL_ERROR "Desktop entry must not set DBusActivatable")
endif()
if(NOT service_content MATCHES "(^|\n)Name=org\\.openkey\\.Settings[ \t]*(\r?\n|$)")
    message(FATAL_ERROR "Unexpected D-Bus activation name")
endif()

# --smoke-test loads embedded QML/resources and exits without bus activation.
check_command("${CMAKE_EXECUTABLE}" -E env
    QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software QT_IM_MODULE=compose
    "${prefix}/bin/openkey-settings" --smoke-test)
message(STATUS "Standalone UI DEB metadata, checksum, payload, desktop entry and embedded QML smoke test passed")
