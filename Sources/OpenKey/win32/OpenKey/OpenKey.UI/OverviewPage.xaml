<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenKeyUI.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="StatusLayout.ColumnSpacing" Value="20" />
                        <Setter Target="StatusLayout.RowSpacing" Value="0" />
                        <Setter Target="StatusToggleColumn.Width" Value="Auto" />
                        <Setter Target="LanguageToggle.(Grid.Row)" Value="0" />
                        <Setter Target="LanguageToggle.(Grid.Column)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel
            Style="{StaticResource PageStackLayoutStyle}">

            <StackPanel Spacing="6">
                <TextBlock TextWrapping="Wrap" x:Uid="OverviewTitle" Style="{StaticResource OpenKeyPageTitleStyle}" Text="Bộ gõ tiếng Việt" />
                <TextBlock
                    x:Uid="OverviewSubtitle"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Bật hoặc tắt bộ gõ, chọn kiểu gõ và bảng mã tiếng Việt."
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border Style="{StaticResource OpenKeySettingsCardStyle}">
                <Grid x:Name="StatusLayout" ColumnSpacing="0" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="StatusToggleColumn" Width="0" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock TextWrapping="Wrap" x:Uid="OverviewStatusTitle" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Trạng thái bộ gõ" />
                        <TextBlock
                            x:Name="LanguageDescription"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="LanguageToggle"
                        x:Uid="LanguageToggle"
                        Grid.Row="1"
                        AutomationProperties.Name="Bật bộ gõ tiếng Việt"
                        AutomationProperties.HelpText="Chuyển giữa chế độ nhập tiếng Việt và tiếng Anh."
                        OffContent="Tiếng Anh"
                        OnContent="Tiếng Việt"
                        TabIndex="0"
                        Toggled="OnLanguageToggled" />
                </Grid>
            </Border>

            <Border Style="{StaticResource OpenKeySettingsCardStyle}">
                <StackPanel Spacing="18">
                    <StackPanel Spacing="8">
                        <TextBlock TextWrapping="Wrap" x:Uid="InputMethodTitle" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Kiểu gõ" />
                        <TextBlock
                            x:Uid="InputMethodDescription"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Telex dùng phím chữ để đặt dấu; VNI dùng các phím số."
                            TextWrapping="Wrap" />
                        <ComboBox
                            x:Name="InputTypeCombo"
                            x:Uid="InputTypeCombo"
                            AutomationProperties.HelpText="Chọn phương thức đặt dấu tiếng Việt."
                            AutomationProperties.Name="Kiểu gõ"
                            HorizontalAlignment="Stretch"
                            TabIndex="1"
                            SelectionChanged="OnInputTypeChanged">
                            <ComboBoxItem x:Uid="InputTypeTelex" Content="Telex" />
                            <ComboBoxItem x:Uid="InputTypeVni" Content="VNI" />
                            <ComboBoxItem x:Uid="InputTypeSimple1" Content="Simple Telex 1" />
                            <ComboBoxItem x:Uid="InputTypeSimple2" Content="Simple Telex 2" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock TextWrapping="Wrap" x:Uid="CodeTableTitle" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Bảng mã" />
                        <TextBlock
                            x:Uid="CodeTableDescription"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Unicode phù hợp với hầu hết ứng dụng và được khuyến nghị."
                            TextWrapping="Wrap" />
                        <ComboBox
                            x:Name="CodeTableCombo"
                            x:Uid="CodeTableCombo"
                            AutomationProperties.HelpText="Chọn bảng mã dùng để xuất ký tự tiếng Việt."
                            AutomationProperties.Name="Bảng mã"
                            HorizontalAlignment="Stretch"
                            TabIndex="2"
                            SelectionChanged="OnCodeTableChanged">
                            <ComboBoxItem x:Uid="CodeUnicode" Content="Unicode" />
                            <ComboBoxItem x:Uid="CodeTcvn3" Content="TCVN3 (ABC)" />
                            <ComboBoxItem x:Uid="CodeVniWindows" Content="VNI Windows" />
                            <ComboBoxItem x:Uid="CodeUnicodeComposite" Content="Unicode tổ hợp" />
                            <ComboBoxItem x:Uid="CodeVietnameseLocale" Content="Vietnamese locale CP 1258" />
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource OpenKeySettingsCardStyle}">
                <ToggleSwitch
                    x:Name="RememberCodeToggle"
                    x:Uid="RememberCodeToggle"
                    AutomationProperties.HelpText="Ghi nhớ bảng mã riêng cho từng ứng dụng."
                    AutomationProperties.Name="Ghi nhớ bảng mã theo ứng dụng"
                    Header="Ghi nhớ bảng mã theo ứng dụng"
                    OffContent="Tắt"
                    OnContent="Bật"
                    TabIndex="3"
                    Toggled="OnRememberCodeToggled" />
            </Border>

            <Border Style="{StaticResource OpenKeySettingsCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="CaretEditingTitle" Text="Sửa dấu tại con trỏ" TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="CaretEditingDescription" Text="Đặt con trỏ cuối từ đã gõ để thêm hoặc bỏ dấu. Dùng Unicode dựng sẵn. Lựa chọn được ghi nhớ qua lần đăng nhập; bật Khởi động OpenKey cùng Windows để tự khôi phục." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="CaretEnableButton" x:Uid="CaretEnableButton" Content="Bật và sử dụng" Click="OnEnableCaretEditing" Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="CaretDisableButton" x:Uid="CaretDisableButton" Content="Tắt" Click="OnDisableCaretEditing" />
                    </StackPanel>
                    <InfoBar x:Name="CaretStatus" IsOpen="True" IsClosable="False" Severity="Informational" Title="OpenKey Caret Editing" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Border>

            <InfoBar
                x:Name="SettingsStatus"
                x:Uid="OverviewStatus"
                AutomationProperties.LiveSetting="Polite"
                AutomationProperties.Name="Trạng thái cấu hình"
                IsClosable="False"
                IsOpen="True"
                Message="Các trang cài đặt dùng chung dữ liệu với OpenKey Win32."
                Severity="Informational"
                Title="Cấu hình tương thích" />
        </StackPanel>
    </ScrollViewer>
    </Grid>
</Page>
