#include "AppResources.h"

// Reuse the original OpenKey asset without another deployment-time file.
IDI_OPENKEY_UI ICON "..\\OpenKey\\icon.ico"

1 VERSIONINFO
 FILEVERSION 3,0,6,0
 PRODUCTVERSION 3,0,6,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "OpenKey contributors"
            VALUE "FileDescription", "OpenKey Fluent UI"
            VALUE "FileVersion", "3.0.6.0"
            VALUE "InternalName", "OpenKey.UI.exe"
            VALUE "OriginalFilename", "OpenKey.UI.exe"
            VALUE "ProductName", "OpenKey Fluent"
            VALUE "ProductVersion", "3.0.6.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
