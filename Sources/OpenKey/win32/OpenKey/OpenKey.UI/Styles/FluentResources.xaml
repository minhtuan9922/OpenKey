<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dimensions are app tokens; colors/type/control states remain WinUI
         theme resources so accent, light/dark and high contrast stay native. -->
    <Thickness x:Key="OpenKeyPagePadding">24,24,24,32</Thickness>
    <Thickness x:Key="OpenKeyCardPadding">20</Thickness>
    <Thickness x:Key="OpenKeyCardStrokeThickness">1</Thickness>
    <CornerRadius x:Key="OpenKeyCardCornerRadius">8</CornerRadius>
    <x:Double x:Key="OpenKeySectionSpacing">20</x:Double>

    <DataTemplate x:Key="WrappingTextTemplate">
        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
    </DataTemplate>
    <Style x:Key="PageStackLayoutStyle" TargetType="StackPanel">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="{StaticResource OpenKeyPagePadding}" />
        <Setter Property="Spacing" Value="{StaticResource OpenKeySectionSpacing}" />
    </Style>
    <Style x:Key="PageGridLayoutStyle" TargetType="Grid">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="{StaticResource OpenKeyPagePadding}" />
        <Setter Property="RowSpacing" Value="{StaticResource OpenKeySectionSpacing}" />
    </Style>
    <Style x:Key="OpenKeySettingsCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource OpenKeyCardPadding}" />
        <Setter Property="CornerRadius" Value="{StaticResource OpenKeyCardCornerRadius}" />
        <Setter Property="BorderThickness" Value="{StaticResource OpenKeyCardStrokeThickness}" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    </Style>
    <Style x:Key="OpenKeyPageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style TargetType="ToggleSwitch">
        <Setter Property="HeaderTemplate" Value="{StaticResource WrappingTextTemplate}" />
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="ContentTemplate" Value="{StaticResource WrappingTextTemplate}" />
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="HeaderTemplate" Value="{StaticResource WrappingTextTemplate}" />
    </Style>
</ResourceDictionary>
