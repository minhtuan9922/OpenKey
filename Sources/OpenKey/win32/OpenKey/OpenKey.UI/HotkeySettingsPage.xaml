<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenKeyUI.HotkeySettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel
            Style="{StaticResource PageStackLayoutStyle}">

            <StackPanel Spacing="6">
                <TextBlock TextWrapping="Wrap" x:Uid="HotkeyTitle" Style="{StaticResource OpenKeyPageTitleStyle}" Text="Phím tắt" />
                <TextBlock
                    x:Uid="HotkeySubtitle"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Thiết lập tổ hợp phím dùng để chuyển nhanh giữa chế độ tiếng Việt và tiếng Anh."
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border Style="{StaticResource OpenKeySettingsCardStyle}">
                <StackPanel Spacing="18">
                    <TextBlock TextWrapping="Wrap" x:Uid="HotkeySection" Style="{StaticResource SubtitleTextBlockStyle}" Text="Phím chuyển chế độ" />
                    <TextBlock
                        x:Uid="HotkeyDescription"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Chọn ít nhất một phím bổ trợ để tránh kích hoạt nhầm khi đang nhập văn bản."
                        TextWrapping="Wrap" />

                    <StackPanel Spacing="8">
                        <TextBlock TextWrapping="Wrap" x:Uid="ModifierTitle" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Phím bổ trợ" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Uid="HotkeySettingsPageCtrlCheckBox" x:Name="CtrlCheckBox" AutomationProperties.Name="Dùng phím Ctrl" Content="Ctrl" Click="OnHotkeyChanged" TabIndex="0" />
                            <CheckBox x:Uid="HotkeySettingsPageAltCheckBox" x:Name="AltCheckBox" Grid.Column="1" AutomationProperties.Name="Dùng phím Alt" Content="Alt" Click="OnHotkeyChanged" TabIndex="1" />
                            <CheckBox x:Uid="HotkeySettingsPageWinCheckBox" x:Name="WinCheckBox" Grid.Column="2" AutomationProperties.Name="Dùng phím Windows" Content="Win" Click="OnHotkeyChanged" TabIndex="2" />
                            <CheckBox x:Uid="HotkeySettingsPageShiftCheckBox" x:Name="ShiftCheckBox" Grid.Column="3" AutomationProperties.Name="Dùng phím Shift" Content="Shift" Click="OnHotkeyChanged" TabIndex="3" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock TextWrapping="Wrap" x:Uid="PrimaryKeyTitle" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Phím chính" />
                        <ComboBox
                            x:Name="KeyCombo"
                            x:Uid="KeyCombo"
                            AutomationProperties.HelpText="Chọn phím chính của tổ hợp chuyển chế độ."
                            AutomationProperties.Name="Phím chính"
                            HorizontalAlignment="Stretch"
                            TabIndex="4"
                            SelectionChanged="OnKeyChanged" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock TextWrapping="Wrap" x:Uid="CurrentShortcutTitle" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Tổ hợp hiện tại" />
                        <TextBlock x:Uid="HotkeySettingsPageHotkeyPreview"
                            x:Name="HotkeyPreview"
                            AutomationProperties.LiveSetting="Polite"
                            AutomationProperties.Name="Tổ hợp phím hiện tại"
                            FontFamily="Consolas"
                            FontSize="18"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource OpenKeySettingsCardStyle}">
                <ToggleSwitch
                    x:Name="BeepToggle"
                    x:Uid="BeepToggle"
                    AutomationProperties.Name="Phát âm báo khi chuyển chế độ"
                    Header="Phát âm báo khi chuyển chế độ"
                    OffContent="Tắt"
                    OnContent="Bật"
                    TabIndex="5"
                    Toggled="OnHotkeyChanged" />
            </Border>

            <InfoBar
                x:Name="ShortcutWarning"
                x:Uid="ShortcutWarning"
                AutomationProperties.LiveSetting="Assertive"
                AutomationProperties.Name="Cảnh báo phím tắt"
                IsClosable="False"
                IsOpen="False"
                Message="Tổ hợp không có phím bổ trợ có thể gây xung đột khi nhập văn bản."
                Severity="Warning"
                Title="Phím tắt dễ xung đột" />

            <InfoBar
                x:Name="SettingsStatus"
                x:Uid="HotkeySettingsStatus"
                AutomationProperties.LiveSetting="Polite"
                AutomationProperties.Name="Trạng thái lưu phím tắt"
                IsClosable="False"
                IsOpen="False" />
        </StackPanel>
    </ScrollViewer>
</Page>
