<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenKeyUI.AdvancedSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel
            Style="{StaticResource PageStackLayoutStyle}">

            <StackPanel Spacing="6">
                <TextBlock TextWrapping="Wrap" x:Uid="AdvancedTitle" Style="{StaticResource OpenKeyPageTitleStyle}" Text="Cài đặt nâng cao" />
                <TextBlock
                    x:Uid="AdvancedSubtitle"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Tinh chỉnh hành vi nhập liệu, giao diện khay hệ thống và kiểm tra cập nhật."
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border Style="{StaticResource OpenKeySettingsCardStyle}">
                <StackPanel Spacing="18">
                    <TextBlock TextWrapping="Wrap" x:Uid="AdvancedInputSection" Style="{StaticResource SubtitleTextBlockStyle}" Text="Nhập liệu nâng cao" />
                    <ToggleSwitch
                        x:Name="UpperCaseFirstCharToggle"
                        x:Uid="UpperCaseFirstCharToggle"
                        AutomationProperties.Name="Tự động viết hoa sau dấu chấm và khi xuống dòng"
                        Header="Tự động viết hoa sau dấu chấm và khi xuống dòng"
                        OffContent="Tắt"
                        OnContent="Bật"
                        TabIndex="0"
                        Toggled="OnPreferenceToggled" />
                    <ToggleSwitch
                        x:Name="AllowConsonantToggle"
                        x:Uid="AllowConsonantToggle"
                        AutomationProperties.Name="Cho phép z, w, f, j làm phụ âm"
                        Header="Cho phép z, w, f, j làm phụ âm"
                        OffContent="Tắt"
                        OnContent="Bật"
                        TabIndex="1"
                        Toggled="OnPreferenceToggled" />
                    <ToggleSwitch
                        x:Name="TemporarySpellingToggle"
                        x:Uid="TemporarySpellingToggle"
                        AutomationProperties.Name="Ctrl tạm tắt kiểm tra chính tả cho một từ"
                        Header="Ctrl tạm tắt kiểm tra chính tả cho một từ"
                        OffContent="Tắt"
                        OnContent="Bật"
                        TabIndex="2"
                        Toggled="OnPreferenceToggled" />
                    <TextBlock
                        x:Name="SpellingRequirement"
                        x:Uid="SpellingRequirement"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Text="Hãy bật kiểm tra chính tả để sử dụng hai tùy chọn chính tả nâng cao."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource OpenKeySettingsCardStyle}">
                <StackPanel Spacing="18">
                    <TextBlock TextWrapping="Wrap" x:Uid="AppearanceStartupSection" Style="{StaticResource SubtitleTextBlockStyle}" Text="Giao diện &amp; khởi động" />
                    <ToggleSwitch
                        x:Name="GrayIconToggle"
                        x:Uid="GrayIconToggle"
                        AutomationProperties.Name="Dùng biểu tượng đơn sắc trong khay hệ thống"
                        Header="Dùng biểu tượng đơn sắc trong khay hệ thống"
                        OffContent="Tắt"
                        OnContent="Bật"
                        TabIndex="3"
                        Toggled="OnPreferenceToggled" />
                    <ToggleSwitch
                        x:Name="RunWithWindowsToggle"
                        x:Uid="RunWithWindowsToggle"
                        AutomationProperties.Name="Khởi động OpenKey cùng Windows"
                        Header="Khởi động OpenKey cùng Windows"
                        OffContent="Tắt"
                        OnContent="Bật"
                        TabIndex="4"
                        Toggled="OnPreferenceToggled" />
                    <ToggleSwitch
                        x:Name="ShowOnStartupToggle"
                        x:Uid="ShowOnStartupToggle"
                        AutomationProperties.Name="Hiện cửa sổ điều khiển khi OpenKey khởi động"
                        Header="Hiện cửa sổ điều khiển khi OpenKey khởi động"
                        OffContent="Tắt"
                        OnContent="Bật"
                        TabIndex="5"
                        Toggled="OnPreferenceToggled" />
                    <ToggleSwitch
                        x:Name="CheckUpdatesToggle"
                        x:Uid="CheckUpdatesToggle"
                        AutomationProperties.Name="Kiểm tra phiên bản mới khi khởi động"
                        Header="Kiểm tra phiên bản mới khi khởi động"
                        OffContent="Tắt"
                        OnContent="Bật"
                        TabIndex="6"
                        Toggled="OnPreferenceToggled" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource OpenKeySettingsCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="UiLanguageSection" Text="Ngôn ngữ giao diện"
                        Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                    <ComboBox x:Name="UiLanguageCombo" x:Uid="UiLanguageCombo"
                        Header="Ngôn ngữ hiển thị" AutomationProperties.Name="Ngôn ngữ hiển thị"
                        HorizontalAlignment="Stretch" TabIndex="7" SelectionChanged="OnUiLanguageChanged">
                        <ComboBoxItem Content="Tiếng Việt" />
                        <ComboBoxItem Content="English" />
                    </ComboBox>
                    <TextBlock x:Uid="UiLanguageHelp" TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Đóng và mở lại cửa sổ giao diện để áp dụng. Không thay đổi chế độ gõ Việt/Anh." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource OpenKeySettingsCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="UiThemeSection" Text="Giao diện sáng/tối"
                        Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                    <ComboBox x:Name="UiThemeCombo" x:Uid="UiThemeCombo"
                        Header="Chủ đề giao diện" AutomationProperties.Name="Chủ đề giao diện"
                        HorizontalAlignment="Stretch" TabIndex="8" SelectionChanged="OnUiThemeChanged">
                        <ComboBoxItem x:Uid="UiThemeSystem" Content="Theo hệ thống" />
                        <ComboBoxItem x:Uid="UiThemeLight" Content="Sáng" />
                        <ComboBoxItem x:Uid="UiThemeDark" Content="Tối" />
                    </ComboBox>
                    <TextBlock x:Uid="UiThemeHelp" TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Áp dụng ngay, không thay đổi cấu hình bộ gõ. Mặc định theo giao diện Windows." />
                </StackPanel>
            </Border>

            <InfoBar x:Name="SpellingDependencyWarning" x:Uid="SpellingDependencyWarning"
                Severity="Warning" IsOpen="False" IsClosable="False"
                AutomationProperties.LiveSetting="Polite"
                AutomationProperties.Name="Cảnh báo tùy chọn chính tả"
                Title="Tùy chọn chính tả nâng cao đang bị khóa"
                Message="Một số tùy chọn chính tả nâng cao vẫn được giữ, nhưng cần bật Kiểm tra chính tả để chỉnh sửa. OpenKey không tự tắt lựa chọn đã lưu." />

            <InfoBar
                x:Name="SettingsStatus"
                x:Uid="SettingsStatus"
                AutomationProperties.LiveSetting="Polite"
                AutomationProperties.Name="Trạng thái lưu cấu hình"
                IsClosable="False"
                IsOpen="False" />
        </StackPanel>
    </ScrollViewer>
</Page>
