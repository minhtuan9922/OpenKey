<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenKeyUI.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="AboutCards.ColumnSpacing" Value="16" />
                        <Setter Target="AboutCards.RowSpacing" Value="0" />
                        <Setter Target="AboutCardsSecondColumn.Width" Value="*" />
                        <Setter Target="AboutCardsSecond.(Grid.Row)" Value="0" />
                        <Setter Target="AboutCardsSecond.(Grid.Column)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel
            Style="{StaticResource PageStackLayoutStyle}">
            <StackPanel Spacing="6">
                <TextBlock TextWrapping="Wrap" x:Uid="AboutLabel1" Style="{StaticResource OpenKeyPageTitleStyle}" Text="Giới thiệu OpenKey" />
                <TextBlock x:Uid="AboutLabel2"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Bộ gõ tiếng Việt mã nguồn mở, gọn nhẹ và tôn trọng trải nghiệm Windows."
                    TextWrapping="Wrap" />
            </StackPanel>

                <Border Style="{StaticResource OpenKeySettingsCardStyle}"
                Padding="28"
                CornerRadius="12">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="80"
                        Height="80"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="18">
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="38"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Glyph="&#xE765;" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource OpenKeyPageTitleStyle}" Text="OpenKey" />
                        <TextBlock TextWrapping="Wrap" x:Name="VersionText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock TextWrapping="Wrap"
                            x:Name="BuildDateText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="10">
                            <Button ContentTemplate="{StaticResource WrappingTextTemplate}" x:Uid="AboutCheckUpdateButton"
                                x:Name="CheckUpdateButton"
                                AutomationProperties.HelpText="Kiểm tra phiên bản OpenKey mới qua Internet."
                                AutomationProperties.Name="Kiểm tra cập nhật"
                                Click="OnCheckUpdatesClicked"
                                Content="Kiểm tra cập nhật"
                                TabIndex="0" />
                            <ProgressRing x:Uid="AboutUpdateProgress"
                                x:Name="UpdateProgress"
                                Width="20"
                                Height="20"
                                AutomationProperties.Name="Đang kiểm tra cập nhật"
                                IsActive="False" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="AboutCards" ColumnSpacing="0" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="AboutCardsSecondColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource OpenKeySettingsCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock TextWrapping="Wrap" x:Uid="AboutLabel3" Style="{StaticResource SubtitleTextBlockStyle}" Text="Dự án" />
                        <TextBlock x:Uid="AboutLabel4"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Xem mã nguồn, bản phát hành và theo dõi cộng đồng OpenKey."
                            TextWrapping="Wrap" />
                        <Button ContentTemplate="{StaticResource WrappingTextTemplate}" x:Uid="AboutLabel5"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Mở mã nguồn OpenKey trên GitHub"
                            Click="OnLinkClicked"
                            Content="Mã nguồn trên GitHub"
                            TabIndex="1"
                            Tag="https://github.com/tuyenvm/OpenKey" />
                        <Button ContentTemplate="{StaticResource WrappingTextTemplate}" x:Uid="AboutLabel6"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Mở trang các bản phát hành OpenKey"
                            Click="OnLinkClicked"
                            Content="Các bản phát hành"
                            TabIndex="2"
                            Tag="https://github.com/tuyenvm/OpenKey/releases" />
                        <Button ContentTemplate="{StaticResource WrappingTextTemplate}" x:Uid="AboutLabel7"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Mở cộng đồng OpenKey"
                            Click="OnLinkClicked"
                            Content="Cộng đồng OpenKey"
                            TabIndex="3"
                            Tag="https://www.facebook.com/OpenKeyVN" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource OpenKeySettingsCardStyle}" x:Name="AboutCardsSecond" Grid.Row="1">
                    <StackPanel Spacing="12">
                        <TextBlock TextWrapping="Wrap" x:Uid="AboutLabel8" Style="{StaticResource SubtitleTextBlockStyle}" Text="Giấy phép" />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}" Text="GNU General Public License v3" />
                        <TextBlock x:Uid="AboutLabel9"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Bạn có quyền sử dụng, nghiên cứu, sửa đổi và phân phối OpenKey theo các điều khoản của GPLv3."
                            TextWrapping="Wrap" />
                        <Button ContentTemplate="{StaticResource WrappingTextTemplate}" x:Uid="AboutLabel10"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Đọc giấy phép GPL phiên bản 3"
                            Click="OnLinkClicked"
                            Content="Đọc giấy phép GPLv3"
                            TabIndex="4"
                            Tag="https://www.gnu.org/licenses/gpl-3.0.html" />
                        <TextBlock x:Uid="AboutLabel11"
                            Margin="0,8,0,0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Copyright © 2019–2026 Mai Vũ Tuyền và các cộng tác viên."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <InfoBar x:Uid="AboutLinkStatus"
                x:Name="LinkStatus"
                AutomationProperties.LiveSetting="Assertive"
                AutomationProperties.Name="Trạng thái liên kết và cập nhật"
                IsClosable="True"
                IsOpen="False"
                Severity="Error" />
        </StackPanel>
    </ScrollViewer>
    </Grid>
</Page>
